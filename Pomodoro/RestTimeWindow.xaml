<Window x:Class="Pomodoro.RestTimeWindow"
        x:Name="RestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pomodoro"
        mc:Ignorable="d"
        Title="RestTimeWindow" Height="450" Width="800"
        WindowState="Maximized"
        WindowStyle="None"
        Topmost="True"
        KeyDown="Esc_Key_Pressed">
    <Grid>
        <TextBox Text="Press Esc to stop" Height="30" Width="125" VerticalAlignment="Bottom" Margin="0,0,0,10" FontSize="16" BorderBrush="{x:Null}"></TextBox>

        <ProgressBar Name="restprogbar" Height="50" Width="700" VerticalAlignment="Bottom" Margin="0,0,0,50">
            <ProgressBar.Triggers>
                <EventTrigger RoutedEvent="ProgressBar.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="restprogbar"
                                             Storyboard.TargetProperty="Value"
                                             From="100" To="0" Duration="{Binding ElementName=RestWindow, Path=_restTime}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </ProgressBar.Triggers>
            
        </ProgressBar>
    </Grid>
</Window>

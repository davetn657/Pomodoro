<Window x:Class="Pomodoro.RestTimeWindow"
        x:Name="RestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pomodoro"
        mc:Ignorable="d"
        Title="RestTimeWindow" Height="450" Width="800"
        WindowState="Maximized"
        WindowStyle="None"
        Topmost="True"
        KeyDown="Esc_Key_Pressed">
    <Grid>
        <TextBox Text="Press Esc to stop" Height="20" Width="95"  HorizontalAlignment="Right" VerticalAlignment="Top"></TextBox>

        <ProgressBar Name="restprogbar" Height="40" Width="700" VerticalAlignment="Bottom" Margin="0,0,0,150">
            <ProgressBar.Triggers>
                <EventTrigger RoutedEvent="ProgressBar.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="restprogbar"
                                             Storyboard.TargetProperty="Value"
                                             From="100" To="0" Duration="{Binding ElementName=RestWindow, Path=_restTime}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </ProgressBar.Triggers>
        </ProgressBar>

        <Button Name="tiponebtn" Height="100" Width="100" VerticalAlignment="Bottom" Margin="0,0,600,20" Click="tiponebtn_Click"></Button>
        <Button Name="tiptwobtn" Height="100" Width="100" VerticalAlignment="Bottom" Margin="0,0,300,20"></Button>
        <Button Name="tipthreebtn" Height="100" Width="100" VerticalAlignment="Bottom" Margin="0,0,0,20"></Button>
        <Button Name="tipfourbtn" Height="100" Width="100" VerticalAlignment="Bottom" Margin="300,0,00,20"></Button>
        <Button Name="tipfivebtn" Height="100" Width="100" VerticalAlignment="Bottom" Margin="600,0,0,20"></Button>
    </Grid>
</Window>
